
#include<stdio.h>
#include<conio.h>

void main()
{
    int n, w, lost, lostdone = 0;
    int i, j, end;
    clrscr();
    printf("\t SELECTIVE REPEAT PROTOCOL\n\n");
    printf("Enter the total number of frames : ");
    scanf("%d", &n);
    printf("Enter the window size            : ");
    scanf("%d", &w);
    printf("Enter the frame number to be lost (0 for none): ");
    scanf("%d", &lost);
    printf("\n");

    i = 1;
    while (i <= n)
    {
        end = i + w - 1;
        if (end > n)
            end = n;

        printf("Sender   : Window [%d - %d]\n", i, end);
        for (j = i; j <= end; j++)
            printf("Sender   : Sending frame %d\n", j);

        for (j = i; j <= end; j++)
        {
            if (j == lost && lostdone == 0)
                printf("Receiver : Frame %d lost, NAK %d sent\n", j, j);
            else
                printf("Receiver : Frame %d received, ACK %d sent\n", j, j);
        }

        if (lost >= i && lost <= end && lostdone == 0)
        {
            printf("Sender   : NAK %d received, retransmitting only frame %d\n", lost, lost);
            printf("Receiver : Frame %d received, ACK %d sent\n", lost, lost);
            lostdone = 1;
        }
        printf("-----------------------------------------\n");
        i = end + 1;
    }
    printf("\nAll frames delivered successfully.\n");
    getch();
}

