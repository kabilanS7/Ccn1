#include<stdio.h>
#include<conio.h>

/* Sliding window protocol - Go Back N */
void main()
{
    int n, w, lost, lostdone = 0;
    int i, j, k, end, flag;
    clrscr();
    printf("\t SLIDING WINDOW PROTOCOL (Go-Back-N)\n\n");
    printf("Enter the total number of frames : ");
    scanf("%d", &n);
    printf("Enter the window size            : ");
    scanf("%d", &w);
    printf("Enter the frame number to be lost (0 for none): ");
    scanf("%d", &lost);
    printf("\n");

    i = 1;
    while (i <= n)
    {
        end = i + w - 1;
        if (end > n)
            end = n;

        printf("Sender   : Window [%d - %d]\n", i, end);
        for (j = i; j <= end; j++)
            printf("Sender   : Sending frame %d\n", j);

        flag = 0;
        for (j = i; j <= end; j++)
        {
            if (j == lost && lostdone == 0)
            {
                printf("Receiver : Frame %d lost\n", j);
                for (k = j + 1; k <= end; k++)
                    printf("Receiver : Frame %d discarded (out of order)\n", k);
                printf("Sender   : Timeout, go back to frame %d\n", j);
                lostdone = 1;
                flag = 1;
                i = j;
                break;
            }
            printf("Receiver : Frame %d received, ACK %d sent\n", j, j);
        }

        if (flag == 0)
        {
            printf("Sender   : Window slides forward\n");
            i = end + 1;
        }
        printf("-----------------------------------------\n");
    }
    printf("\nAll frames delivered successfully.\n");
    getch();
}

